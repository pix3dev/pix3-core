{
  "name": "@pix3/cli",
  "version": "2.0.0-alpha.0",
  "description": "Pix3 command line: create a project, check and smoke-test it, open the editor in Chrome for your coding agent (Claude Code, Codex, ...) and configure chrome-devtools-mcp for it.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pix3dev/pix3-core.git",
    "directory": "packages/cli"
  },
  "bin": {
    "pix3": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "templates",
    "kit",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-bin.mjs && node scripts/build-validate.mjs && node scripts/build-smoke.mjs",
    "copy-templates": "node scripts/copy-templates.mjs",
    "prepack": "npm run copy-templates && npm run build && npm run build-runtime-types && npm run build-kit",
    "postpack": "node scripts/copy-templates.mjs --clean",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "build-kit": "node scripts/build-kit.mjs",
    "build-runtime-types": "node scripts/build-runtime-types.mjs"
  },
  "keywords": [
    "pix3",
    "cli",
    "mcp",
    "game-engine",
    "agent"
  ],
  "license": "Apache-2.0",
  "optionalDependencies": {
    "esbuild": "^0.27.3"
  },
  "devDependencies": {
    "@pix3/runtime": "2.0.0-alpha.0",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "typescript": "~5.8.3",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  }
}
