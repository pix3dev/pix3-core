{
  "name": "@pix3/editor-core",
  "version": "2.0.0-alpha.2",
  "description": "Prebuilt Pix3 editor (Lit), mounted by @pix3/vite-plugin through EditorHost.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pix3dev/pix3-core.git",
    "directory": "packages/editor-core"
  },
  "homepage": "https://github.com/pix3dev/pix3-core/tree/main/packages/editor-core#readme",
  "bugs": {
    "url": "https://github.com/pix3dev/pix3-core/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./editor.css": "./dist/editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && node scripts/check-dist.mjs",
    "prepack": "npm run build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.1",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@pix3/runtime": "2.0.0-alpha.2",
    "postprocessing": ">=6.39.0",
    "three": "~0.183.0"
  },
  "devDependencies": {
    "@types/feather-icons": "^4.29.4",
    "@types/three": "^0.183.1",
    "feather-icons": "^4.29.2",
    "golden-layout": "^2.6.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "valtio": "^2.1.8",
    "vite": "^8.3.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
