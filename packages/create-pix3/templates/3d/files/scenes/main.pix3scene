# Pix3 Scene File (YAML). The entry scene of an empty 3D project: a camera, a key light and an
# ambient fill. Add meshes under game-root; 2D HUD nodes go beside it as top-level 2D nodes.
version: 1.0.0
metadata:
  description: Entry scene
root:
  - id: game-root
    type: Node3D
    name: Game Root
    properties:
      transform:
        position: [0, 0, 0]
        rotationEuler: [0, 0, 0]
        scale: [1, 1, 1]
    children:
      - id: main-camera
        type: Camera3D
        name: Main Camera
        properties:
          projection: perspective
          fov: 60
          near: 0.1
          far: 1000
          transform:
            position: [0, 2, 6]
            rotationEuler: [-10, 0, 0]
            scale: [1, 1, 1]
        children: []
      - id: key-light
        type: DirectionalLightNode
        name: Key Light
        properties:
          intensity: 1.2
          color: "#ffffff"
          transform:
            position: [5, 8, 3]
            rotationEuler: [-45, 35, 0]
            scale: [1, 1, 1]
        children: []
      - id: ambient-light
        type: AmbientLightNode
        name: Ambient Light
        properties:
          intensity: 0.5
          color: "#ffffff"
          transform:
            position: [0, 0, 0]
            rotationEuler: [0, 0, 0]
            scale: [1, 1, 1]
        children: []
