# Pix3 Scene File (YAML). The entry scene of an empty 2D project: a root that stretches over the
# whole screen with a background, and design-area — the design size (pix3project.yaml →
# viewportBaseSize), centred in the screen's safe area. Put the HUD and the game in design-area so
# they stay together on any phone; anchor to game-root only what must reach the screen's edges.
version: 1.0.0
metadata:
  description: Entry scene
root:
  - id: game-root
    type: Group2D
    name: Game Root
    properties:
      width: 1920
      height: 1080
      layout:
        enabled: true
        horizontalAlign: stretch
        verticalAlign: stretch
        left: 0
        right: 0
        top: 0
        bottom: 0
    children:
      - id: background
        type: ColorRect2D
        name: Background
        properties:
          color: "#1a1a2e"
          layout:                  # stretched over the root: the margins size it, no width/height
            enabled: true
            horizontalAlign: stretch
            verticalAlign: stretch
            left: 0
            right: 0
            top: 0
            bottom: 0
        children: []
      - id: design-area
        type: Group2D
        name: Design Area
        properties:
          width: 1920
          height: 1080
          layout:                  # not anchored: the design size, centred in the safe area
            enabled: false
            safeArea: true
        children: []
