{
  // Type-checks sources AND specs (specs run under the root vitest config with
  // `// @vitest-environment node`). The plugin is plain Node ESM loaded by the project's
  // `vite.config.ts`, so relative imports carry `.ts` and are rewritten to `.js` on emit
  // (`tsconfig.build.json`).
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
