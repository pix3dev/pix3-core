{
  "name": "@pix3/vite-plugin",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Pix3 editor, file API, sync barrier and build as a Vite plugin.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pix3dev/pix3-core.git",
    "directory": "packages/vite-plugin"
  },
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p player/tsconfig.build.json",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p player/tsconfig.json"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "vite-plugin-singlefile": "^2.3.3",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@pix3/runtime": "2.0.0-alpha.0",
    "vite": "^7 || ^8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "typescript": "~5.8.3",
    "vite": "^8.3.3"
  },
  "license": "Apache-2.0"
}
